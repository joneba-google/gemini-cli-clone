+/**
+ * @license
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { validatePath } from './path-validator.js';
+
+/**
+ * Validates and resolves a path extracted from an @-command or a potential path string.
+ * If the path is valid, it is returned.
+ * If it is invalid (e.g. contains log fragments), it attempts to extract a valid embedded path.
+ * If no valid path can be resolved or extracted, returns null.
+ */
+export function resolveAtCommandPath(inputPath: string): string | null {
+  if (typeof inputPath !== 'string') {
+    return null;
+  }
+
+  // 1. If it's already a valid path, return it directly.
+  if (validatePath(inputPath)) {
+    return inputPath;
+  }
+
+  // 2. Otherwise, attempt to extract a valid path from the fragment.
+  return tryExtractPath(inputPath);
+}
+
+/**
+ * Attempts to extract a valid file path from a log snippet, stack trace, or malformed path.
+ */
+export function tryExtractPath(input: string): string | null {
+  if (typeof input !== 'string' || !input.trim()) {
+    return null;
+  }
+
+  // Split input into words/tokens by whitespace, comma, or semicolons
+  const tokens = input.split(/[\s,;]/);
+
+  for (let token of tokens) {
+    token = token.trim();
+    if (!token) {
+      continue;
+    }
+
+    // 1. Remove surrounding packaging markers like parentheses: (path/to/file) -> path/to/file
+    if (token.startsWith('(') && token.endsWith(')')) {
+      token = token.slice(1, -1).trim();
+    }
+
+    // 2. Remove surrounding square brackets: [path/to/file] -> path/to/file
+    // Ensure we don't stripping brackets that form a part of folder structure, e.g. [my-folder]/file
+    if (token.startsWith('[') && token.endsWith(']') && !token.slice(1, -1).includes('[')) {
+      token = token.slice(1, -1).trim();
+    }
+
+    // 3. Remove surrounding quotes: "path/to/file" or 'path/to/file'
+    if (
+      (token.startsWith('"') && token.endsWith('"')) ||
+      (token.startsWith("'") && token.endsWith("'")) ||
+      (token.startsWith('`') && token.endsWith('`'))
+    ) {
+      token = token.slice(1, -1).trim();
+    }
+
+    // 4. Remove common line/col endings or stack trace suffixes: :123:45, :123
+    token = token.replace(/:\d+:\d+$/, '');
+    token = token.replace(/:\d+$/, '');
+
+    // 5. Basic checks: must contain path separator / or \ or a dot, and not start with standard url schemes
+    if (
+      (token.includes('/') || token.includes('\\') || token.includes('.')) &&
+      !token.startsWith('http://') &&
+      !token.startsWith('https://')
+    ) {
+      if (validatePath(token)) {
+        return token;
+      }
+    }
+  }
+
+  return null;
+}
