diff --git a/packages/core/src/tools/ripGrep.ts b/packages/core/src/tools/ripGrep.ts
index 861b4b0b8..e11847074 100644
--- a/packages/core/src/tools/ripGrep.ts
+++ b/packages/core/src/tools/ripGrep.ts
@@ -10,6 +10,7 @@ import fsPromises from 'node:fs/promises';
 import path from 'node:path';
 import os from 'node:os';
 import { fileURLToPath } from 'node:url';
+import { execSync } from 'node:child_process';
 import {
   BaseDeclarativeTool,
   BaseToolInvocation,
@@ -61,6 +62,43 @@ export async function getRipgrepPath(): Promise<string | null> {
     }
   }
 
+  // Fallback to platform-specific lookup
+  try {
+    if (platform === 'win32') {
+      const output = execSync('where rg', {
+        stdio: ['ignore', 'pipe', 'ignore'],
+        encoding: 'utf8',
+      }).trim();
+      const firstPath = output.split(/\r?\n/)[0]?.trim();
+      if (firstPath && (await fileExists(firstPath))) {
+        return firstPath;
+      }
+    } else {
+      const output = execSync('which rg', {
+        stdio: ['ignore', 'pipe', 'ignore'],
+        encoding: 'utf8',
+      }).trim();
+      if (output && (await fileExists(output))) {
+        return output;
+      }
+    }
+  } catch {
+    // Ignored: platform commands might fail if rg is not in PATH
+  }
+
+  // Fallback to manual PATH lookup if commands are not available/fail
+  const pathEnv = process.env.PATH || '';
+  const pathSeparator = platform === 'win32' ? ';' : ':';
+  const dirs = pathEnv.split(pathSeparator);
+  const exeName = platform === 'win32' ? 'rg.exe' : 'rg';
+  for (const dir of dirs) {
+    if (!dir) continue;
+    const fullPath = path.join(dir, exeName);
+    if (await fileExists(fullPath)) {
+      return fullPath;
+    }
+  }
+
   return null;
 }