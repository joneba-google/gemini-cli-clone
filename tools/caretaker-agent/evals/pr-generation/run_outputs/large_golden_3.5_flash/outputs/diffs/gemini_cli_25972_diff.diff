@@ -0,0 +1,92 @@
+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, it, expect } from 'vitest';
+import { validatePath } from './path-validator.js';
+import { tryExtractPath, resolveAtCommandPath } from './atCommandUtils.js';
+
+describe('path-validator and atCommandUtils', () => {
+  describe('validatePath', () => {
+    it('accepts normal, valid paths', () => {
+      expect(validatePath('src/index.ts')).toBe(true);
+      expect(validatePath('packages/core/src/utils/path-validator.ts')).toBe(true);
+    });
+
+    it('accepts valid paths with spaces, apostrophes, and brackets', () => {
+      expect(validatePath("user's folder/my file.txt")).toBe(true);
+      expect(validatePath('some [bracketed] path/file.js')).toBe(true);
+      expect(validatePath('a path with spaces/subfolder/file.json')).toBe(true);
+    });
+
+    it('rejects paths with newlines or other control characters', () => {
+      expect(validatePath('src/index.ts\n')).toBe(false);
+      expect(validatePath('src/index\r.ts')).toBe(false);
+      expect(validatePath('src/ind\0ex.ts')).toBe(false);
+      expect(validatePath('src/index\t.ts')).toBe(false);
+    });
+
+    it('rejects paths containing log markers', () => {
+      expect(validatePath('AssertionError: expected false to be true')).toBe(false);
+      expect(validatePath('FAIL  packages/core/src/utils/path-validator.test.ts')).toBe(false);
+      expect(validatePath('TestingLibraryElementError: Unable to find element')).toBe(false);
+      expect(validatePath('✓ test passed')).toBe(false);
+      expect(validatePath('× test failed')).toBe(false);
+    });
+
+    it('rejects path strings that are too long (exceeds 4096 characters)', () => {
+      const longPath = 'a/'.repeat(2500) + 'file.txt';
+      expect(validatePath(longPath)).toBe(false);
+    });
+
+    it('rejects paths with components that are too long (exceeds 255 characters)', () => {
+      const longComponent = 'a'.repeat(256);
+      expect(validatePath(`src/${longComponent}/file.ts`)).toBe(false);
+    });
+
+    it('rejects paths with suspicious quotes/backticks/ellipses', () => {
+      expect(validatePath('src/"index".ts')).toBe(false);
+      expect(validatePath('src/`index`.ts')).toBe(false);
+      expect(validatePath('src/.../index.ts')).toBe(false);
+      expect(validatePath('src/index…ts')).toBe(false);
+    });
+  });
+
+  describe('tryExtractPath', () => {
+    it('recovers clean paths directly', () => {
+      expect(tryExtractPath('src/index.ts')).toBe('src/index.ts');
+      expect(tryExtractPath('  src/index.ts  ')).toBe('src/index.ts');
+    });
+
+    it('strips enclosing brackets/quotes/parentheses and trailing line/col numbers', () => {
+      expect(tryExtractPath('"src/index.ts"')).toBe('src/index.ts');
+      expect(tryExtractPath('(src/index.ts:12:35)')).toBe('src/index.ts');
+      expect(tryExtractPath('[src/index.ts:12]')).toBe('src/index.ts');
+    });
+
+    it('extracts valid embedded file path from log segments / stack trace lines', () => {
+      const stackFrame = '  at Context.<anonymous> (packages/core/src/index.ts:12:3)';
+      expect(tryExtractPath(stackFrame)).toBe('packages/core/src/index.ts');
+
+      const logSnippet = 'AssertionError: expected foo is not equal to bar at packages/core/src/utils/atCommandUtils.ts:35';
+      expect(tryExtractPath(logSnippet)).toBe('packages/core/src/utils/atCommandUtils.ts');
+    });
+
+    it('returns null when no valid path is embedded', () => {
+      expect(tryExtractPath('no path here at all')).toBeNull();
+      expect(tryExtractPath('AssertionError (and some other random text...)')).toBeNull();
+    });
+  });
+
+  describe('resolveAtCommandPath', () => {
+    it('resolves valid paths and strips trailing colons/line numbers', () => {
+      expect(resolveAtCommandPath('src/index.ts:45')).toBe('src/index.ts');
+    });
+
+    it('returns null for completely malformed inputs with no salvageable path', () => {
+      expect(resolveAtCommandPath('FAIL  some random text with no file extension')).toBeNull();
+    });
+  });
+});
