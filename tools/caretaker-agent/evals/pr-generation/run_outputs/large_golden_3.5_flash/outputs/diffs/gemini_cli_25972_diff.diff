--- /dev/null
+++ b/packages/core/src/utils/path-validator.ts
@@ -0,0 +1,52 @@
+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+export const MAX_PATH_LENGTH = 4096;
+export const MAX_COMPONENT_LENGTH = 255;
+
+/**
+ * Validates a file path to prevent filesystem crashes on arbitrary or malformed input.
+ */
+export function validatePath(pathStr: string): boolean {
+  if (!pathStr || typeof pathStr !== 'string') {
+    return false;
+  }
+
+  // Length limit check
+  if (pathStr.length > MAX_PATH_LENGTH) {
+    return false;
+  }
+
+  // Control/newline characters: /[\n\r\0\t]/
+  if (/[\n\r\0\t]/.test(pathStr)) {
+    return false;
+  }
+
+  // Log markers: /(^|[/\\\\])(AssertionError:|FAIL |✓ |× |TestingLibraryElementError:)/
+  if (/(^|[/\\\\])(AssertionError:|FAIL |\u2713 |\u00d7 |TestingLibraryElementError:)/.test(pathStr)) {
+    return false;
+  }
+
+  // Suspicious double quotes, backticks, or other shell / html characters
+  if (pathStr.includes('"') || pathStr.includes('`') || pathStr.includes('<') || pathStr.includes('>') || pathStr.includes('|')) {
+    return false;
+  }
+
+  // Suspicious ellipses
+  if (pathStr.includes('...') || pathStr.includes('…')) {
+    return false;
+  }
+
+  // Segment/component length limit (MAX_COMPONENT_LENGTH = 255)
+  const components = pathStr.split(/[/\\\\]/);
+  for (const component of components) {
+    if (component.length > MAX_COMPONENT_LENGTH) {
+      return false;
+    }
+  }
+
+  return true;
+}