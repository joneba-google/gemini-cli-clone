index 000000000..bdb8e3059
--- /dev/null
+++ b/packages/cli/src/config/vitest-env.ts
@@ -0,0 +1,27 @@
+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { builtinEnvironments } from 'vitest/environments';
+import { File } from 'node:buffer';
+import type { Environment } from 'vitest';
+
+const nodeFileEnvironment: Environment = {
+  name: 'node-file',
+  async setup(globalValue: Record<string, unknown>, environmentOptions: Record<string, unknown>) {
+    const { teardown } = await builtinEnvironments.node.setup(globalValue, environmentOptions);
+    if (!('File' in globalValue)) {
+      globalValue['File'] = File;
+    }
+    return {
+      async teardown(globalCtx) {
+        await teardown(globalCtx);
+      }
+    };
+  }
+};
+
+// eslint-disable-next-line import/no-default-export
+export default nodeFileEnvironment;
