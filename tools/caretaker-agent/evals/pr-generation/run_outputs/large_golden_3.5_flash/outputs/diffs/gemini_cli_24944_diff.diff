+
+import { describe, it, expect } from 'vitest';
+import { ApprovalMode } from '../policy/types.js';
+import { CoreToolCallStatus } from '../scheduler/types.js';
+import {
+  UPDATE_TOPIC_TOOL_NAME,
+  UPDATE_TOPIC_DISPLAY_NAME,
+  ASK_USER_DISPLAY_NAME,
+  WRITE_FILE_DISPLAY_NAME,
+} from '../tools/tool-names.js';
+import {
+  isRenderedInHistory,
+  belongsInConfirmationQueue,
+  isVisibleInToolGroup,
+  buildToolVisibilityContext,
+} from './tool-visibility.js';
+
+describe('tool-visibility', () => {
+  describe('belongsInConfirmationQueue', () => {
+    it('should return false for update_topic tool name or display name', () => {
+      expect(
+        belongsInConfirmationQueue({
+          name: UPDATE_TOPIC_TOOL_NAME,
+          displayName: 'UpdateTopic',
+          status: CoreToolCallStatus.AwaitingApproval,
+          hasResultDisplay: false,
+        }),
+      ).toBe(false);
+
+      expect(
+        belongsInConfirmationQueue({
+          name: 'some_other_name',
+          displayName: UPDATE_TOPIC_DISPLAY_NAME,
+          status: CoreToolCallStatus.AwaitingApproval,
+          hasResultDisplay: false,
+        }),
+      ).toBe(false);
+    });
+
+    it('should return true for standard tools', () => {
+      expect(
+        belongsInConfirmationQueue({
+          name: 'write_file',
+          displayName: WRITE_FILE_DISPLAY_NAME,
+          status: CoreToolCallStatus.AwaitingApproval,
+          hasResultDisplay: false,
+        }),
+      ).toBe(true);
+    });
+  });
+
+  describe('isRenderedInHistory', () => {
+    it('should return false when parentCallId is set', () => {
+      expect(
+        isRenderedInHistory({
+          name: 'write_file',
+          displayName: WRITE_FILE_DISPLAY_NAME,
+          status: CoreToolCallStatus.Success,
+          hasResultDisplay: true,
+          parentCallId: 'parent-123',
+        }),
+      ).toBe(false);
+    });
+
+    it('should handle Ask User correctly based on status and hasResultDisplay', () => {
+      // Pending statuses of Ask User should not be rendered
+      const pendingStatuses = [
+        CoreToolCallStatus.Scheduled,
+        CoreToolCallStatus.Validating,
+        CoreToolCallStatus.Executing,
+        CoreToolCallStatus.AwaitingApproval,
+      ];
+      for (const status of pendingStatuses) {
+        expect(
+          isRenderedInHistory({
+            name: 'ask_user',
+            displayName: ASK_USER_DISPLAY_NAME,
+            status,
+            hasResultDisplay: false,
+          }),
+        ).toBe(false);
+      }
+
+      // Successful/completed should be rendered
+      expect(
+        isRenderedInHistory({
+          name: 'ask_user',
+          displayName: ASK_USER_DISPLAY_NAME,
+          status: CoreToolCallStatus.Success,
+          hasResultDisplay: true,
+        }),
+      ).toBe(true);
+
+      // Error with result display should be rendered
+      expect(
+        isRenderedInHistory({
+          name: 'ask_user',
+          displayName: ASK_USER_DISPLAY_NAME,
+          status: CoreToolCallStatus.Error,
+          hasResultDisplay: true,
+        }),
+      ).toBe(true);
+
+      // Error without result display should NOT be rendered
+      expect(
+        isRenderedInHistory({
+          name: 'ask_user',
+          displayName: ASK_USER_DISPLAY_NAME,
+          status: CoreToolCallStatus.Error,
+          hasResultDisplay: false,
+        }),
+      ).toBe(false);
+    });
+
+    it('should check Plan Mode for WriteFile and Edit', () => {
+      expect(
+        isRenderedInHistory({
+          name: 'write_file',
+          displayName: WRITE_FILE_DISPLAY_NAME,
+          status: CoreToolCallStatus.Success,
+          approvalMode: ApprovalMode.PLAN,
+          hasResultDisplay: true,
+        }),
+      ).toBe(false);
+
+      expect(
+        isRenderedInHistory({
+          name: 'write_file',
+          displayName: WRITE_FILE_DISPLAY_NAME,
+          status: CoreToolCallStatus.Success,
+          approvalMode: ApprovalMode.DEFAULT,
+          hasResultDisplay: true,
+        }),
+      ).toBe(true);
+    });
+  });
+
+  describe('isVisibleInToolGroup', () => {
+    it('should hide internal errors under low verbosity', () => {
+      expect(
+        isVisibleInToolGroup(
+          {
+            name: 'write_file',
+            displayName: WRITE_FILE_DISPLAY_NAME,
+            status: CoreToolCallStatus.Error,
+            hasResultDisplay: true,
+            isClientInitiated: false,
+          },
+          'low',
+        ),
+      ).toBe(false);
+
+      expect(
+        isVisibleInToolGroup(
+          {
+            name: 'write_file',
+            displayName: WRITE_FILE_DISPLAY_NAME,
+            status: CoreToolCallStatus.Error,
+            hasResultDisplay: true,
+            isClientInitiated: true,
+          },
+          'low',
+        ),
+      ).toBe(true);
+
+      expect(
+        isVisibleInToolGroup(
+          {
+            name: 'write_file',
+            displayName: WRITE_FILE_DISPLAY_NAME,
+            status: CoreToolCallStatus.Error,
+            hasResultDisplay: true,
+            isClientInitiated: false,
+          },
+          'full',
+        ),
+      ).toBe(true);
+    });
+
+    it('should hide tools that are awaiting approval from group history', () => {
+      expect(
+        isVisibleInToolGroup(
+          {
+            name: 'write_file',
+            displayName: WRITE_FILE_DISPLAY_NAME,
+            status: CoreToolCallStatus.AwaitingApproval,
+            hasResultDisplay: false,
+          },
+          'full',
+        ),
+      ).toBe(false);
+    });
+  });
+
+  describe('buildToolVisibilityContext', () => {
+    it('should map from core tc structure', () => {
+      const tc = {
+        status: CoreToolCallStatus.Success,
+        approvalMode: ApprovalMode.DEFAULT,
+        request: {
+          name: 'write_file',
+          originalRequestName: 'write_file',
+        },
+        tool: {
+          displayName: WRITE_FILE_DISPLAY_NAME,
+        },
+        response: {
+          resultDisplay: 'file written',
+        },
+      };
+
+      const ctx = buildToolVisibilityContext(tc);
+      expect(ctx.name).toBe('write_file');
+      expect(ctx.displayName).toBe(WRITE_FILE_DISPLAY_NAME);
+      expect(ctx.status).toBe(CoreToolCallStatus.Success);
+      expect(ctx.hasResultDisplay).toBe(true);
+    });
+  });
+});
