index 000000000..3c34a0eaa
--- /dev/null
+++ b/packages/core/src/utils/path-validator.ts
@@ -0,0 +1,76 @@
+/**
+ * @license
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+export const MAX_PATH_LENGTH = 4096;
+export const MAX_COMPONENT_LENGTH = 255;
+
+/**
+ * Validates a file path or potential path input.
+ * Ensures the path does not contain control characters, newline characters,
+ * typical test/log assertion strings, suspicious quotes/ellipses, and adheres
+ * to path length limits.
+ */
+export function validatePath(inputPath: unknown): boolean {
+  if (typeof inputPath !== 'string') {
+    return false;
+  }
+
+  // 1. Length check
+  if (inputPath.length === 0 || inputPath.length > MAX_PATH_LENGTH) {
+    return false;
+  }
+
+  // 2. Control/newline characters Check
+  // Matches \n, \r, \0, \t
+  if (/[\n\r\0\t]/.test(inputPath)) {
+    return false;
+  }
+
+  // 3. Log markers Check
+  const logMarkerRegex = /(^|[/\\\\])(AssertionError:|FAIL |\u2713 |\u00d7 |TestingLibraryElementError:)/;
+  if (logMarkerRegex.test(inputPath)) {
+    return false;
+  }
+
+  // 4. Suspicious quotes/ellipses Check
+  // Ellipses (three dots or unicode ellipsis)
+  if (/\.\.\.|\u2026/.test(inputPath)) {
+    return false;
+  }
+
+  // Backticks are generally suspicious
+  if (inputPath.includes('`')) {
+    return false;
+  }
+
+  // Double quotes should only be used to wrap the entire path (specifically on Windows)
+  const doubleQuoteCount = (inputPath.match(/"/g) || []).length;
+  if (doubleQuoteCount % 2 !== 0) {
+    return false;
+  }
+  if (doubleQuoteCount > 0) {
+    if (!(inputPath.startsWith('"') && inputPath.endsWith('"') && doubleQuoteCount === 2)) {
+      return false;
+    }
+  }
+
+  // If the path contains spaces, it should also contain at least one path separator (/, \) or a dot (.)
+  // to prevent random sentence fragments from being processed as paths.
+  if (inputPath.includes(' ') && !/[/.]/.test(inputPath) && !inputPath.includes('\\')) {
+    return false;
+  }
+
+  // 5. Component Length Check
+  // Split path by forward/backward slash to validate every path component
+  const components = inputPath.split(/[/\\]/);
+  for (const component of components) {
+    if (component.length > MAX_COMPONENT_LENGTH) {
+      return false;
+    }
+  }
+
+  return true;
+}