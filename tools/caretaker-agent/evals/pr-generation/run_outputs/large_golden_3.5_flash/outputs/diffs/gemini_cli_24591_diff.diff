diff --git a/packages/cli/src/utils/processUtils.ts b/packages/cli/src/utils/processUtils.ts
index c43f5c54f..d9d2a9a60 100644
--- a/packages/cli/src/utils/processUtils.ts
+++ b/packages/cli/src/utils/processUtils.ts
@@ -29,3 +29,67 @@ export async function relaunchApp(): Promise<void> {
   await runExitCleanup();
   process.exit(RELAUNCH_EXIT_CODE);
 }
+
+export interface ProcessWithSea extends NodeJS.Process {
+  isSea?: () => boolean;
+}
+
+export function isSeaEnvironment(): boolean {
+  return (
+    process.env.IS_BINARY === 'true' ||
+    (process as ProcessWithSea).isSea?.() === true
+  );
+}
+
+export function isStandardSea(): boolean {
+  return process.argv[0] !== process.argv[1] && isSeaEnvironment();
+}
+
+export function getScriptArgs(): string[] {
+  return process.argv.slice(isStandardSea() ? 1 : 2);
+}
+
+export interface SpawnConfig {
+  spawnArgs: string[];
+  env: NodeJS.ProcessEnv;
+}
+
+export function getSpawnConfig(
+  nodeArgs: string[],
+  scriptArgs: string[],
+): SpawnConfig {
+  const newEnv = { ...process.env, GEMINI_CLI_NO_RELAUNCH: 'true' };
+  let spawnArgs: string[];
+
+  if (isSeaEnvironment()) {
+    for (const arg of nodeArgs) {
+      if (/[\s'"\\]/.test(arg)) {
+        throw new Error(
+          `Invalid character in Node/SEA argument. Node options containing spaces, quotes, or backslashes are not supported in NODE_OPTIONS during SEA relaunch. Got: "${arg}"`,
+        );
+      }
+    }
+
+    const currentOptions = process.env.NODE_OPTIONS || '';
+    const additionalOptions = nodeArgs.join(' ');
+    const combinedOptions = [currentOptions, additionalOptions]
+      .filter(Boolean)
+      .join(' ');
+
+    if (combinedOptions) {
+      newEnv.NODE_OPTIONS = combinedOptions;
+    }
+
+    spawnArgs = [process.execPath, ...scriptArgs];
+  } else {
+    spawnArgs = [
+      ...process.execArgv,
+      ...nodeArgs,
+      process.argv[1],
+      ...scriptArgs,
+    ];
+  }
+
+  return { spawnArgs, env: newEnv };
+}
+
