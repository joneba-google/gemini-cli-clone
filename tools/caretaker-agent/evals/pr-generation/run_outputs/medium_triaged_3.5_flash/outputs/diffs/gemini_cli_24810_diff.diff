+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, it, expect } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+describe('publish-release action.yml config', () => {
+  it('should use the template input npm-tag for npm publish', () => {
+    const actionPath = join(process.cwd(), '.github/actions/publish-release/action.yml');
+    const content = readFileSync(actionPath, 'utf8');
+
+    // Expected that we have replaced staging-tmp tag with inputs.npm-tag
+    // Let's assert that there is no "staging-tmp" in npm publish anymore
+    // and instead it outputs --tag="${{ inputs.npm-tag }}"
+    
+    // We should match npm publish occurrences and verify their tag parameters
+    const publishBlocks = content.split('npm publish');
+    expect(publishBlocks.length).toBeGreaterThan(1);
+
+    // Skip the first block because it is the text before the first 'npm publish'
+    for (let i = 1; i < publishBlocks.length; i++) {
+      const block = publishBlocks[i];
+      // Let's assert that in the lines immediately following npm publish,
+      // we specify --tag="${{ inputs.npm-tag }}"
+      expect(block).toContain('--tag="${{ inputs.npm-tag }}"');
+      expect(block).not.toContain('--tag staging-tmp');
+      expect(block).not.toContain('--no-tag');
+    }
+  });
+});