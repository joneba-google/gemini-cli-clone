+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { EditorSettingsManager } from './editorSettingsManager.js';
+import { EDITOR_DISPLAY_NAMES } from '@google/gemini-cli-core';
+
+const mockHasValidEditorCommand = vi.hoisted(() => vi.fn());
+const mockAllowEditorTypeInSandbox = vi.hoisted(() => vi.fn());
+
+vi.mock('@google/gemini-cli-core', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@google/gemini-cli-core')>();
+  return {
+    ...actual,
+    hasValidEditorCommand: mockHasValidEditorCommand,
+    allowEditorTypeInSandbox: mockAllowEditorTypeInSandbox,
+  };
+});
+
+describe('EditorSettingsManager', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    mockHasValidEditorCommand.mockReturnValue(true);
+    mockAllowEditorTypeInSandbox.mockReturnValue(true);
+  });
+
+  it('does not call hasValidEditorCommand upon instantiation', () => {
+    new EditorSettingsManager();
+    expect(mockHasValidEditorCommand).not.toHaveBeenCalled();
+  });
+
+  it('lazily queries and caches command availability on getAvailableEditorDisplays()', () => {
+    const manager = new EditorSettingsManager();
+    expect(mockHasValidEditorCommand).not.toHaveBeenCalled();
+
+    const result1 = manager.getAvailableEditorDisplays();
+    const totalEditorTypes = Object.keys(EDITOR_DISPLAY_NAMES).length;
+
+    // It should have queried hasValidEditorCommand for all configured editor types
+    expect(mockHasValidEditorCommand).toHaveBeenCalledTimes(totalEditorTypes);
+
+    // Calling it again should return the cached results without calling hasValidEditorCommand again
+    mockHasValidEditorCommand.mockClear();
+    const result2 = manager.getAvailableEditorDisplays();
+    
+    expect(mockHasValidEditorCommand).not.toHaveBeenCalled();
+    expect(result1).toBe(result2); // cached reference
+  });
+
+  it('correctly maps editor names back according to installed/allowed status', () => {
+    const manager = new EditorSettingsManager();
+
+    // Let's make some return true, some false
+    mockHasValidEditorCommand.mockImplementation((type) =>
+      // Every other editor is not installed
+      type.charCodeAt(0) % 2 === 0
+    );
+
+    mockAllowEditorTypeInSandbox.mockImplementation((type) =>
+      // Every third editor is not allowed in sandbox
+      type.charCodeAt(type.length - 1) % 3 !== 0
+    );
+
+    const displays = manager.getAvailableEditorDisplays();
+    
+    // First display should be 'None'
+    expect(displays[0]).toEqual({
+      name: 'None',
+      type: 'not_set',
+      disabled: false,
+    });
+
+    const editorTypes = Object.keys(EDITOR_DISPLAY_NAMES).sort();
+    editorTypes.forEach((type, index) => {
+      const display = displays[index + 1];
+      expect(display.type).toBe(type);
+
+      const hasEditor = type.charCodeAt(0) % 2 === 0;
+      const isAllowedInSandbox = type.charCodeAt(type.length - 1) % 3 !== 0;
+
+      let expectedSuffix = '';
+      if (!isAllowedInSandbox) {
+        expectedSuffix = ' (Not available in sandbox)';
+      }
+      if (!hasEditor) {
+        expectedSuffix = ' (Not installed)';
+      }
+
+      expect(display.name).toBe(EDITOR_DISPLAY_NAMES[type as keyof typeof EDITOR_DISPLAY_NAMES] + expectedSuffix);
+      expect(display.disabled).toBe(!hasEditor || !isAllowedInSandbox);
+    });
+  });
+});
