+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { expect, describe, it } from 'vitest';
+import { CoreToolCallStatus } from '../scheduler/types.js';
+import { ApprovalMode } from '../policy/types.js';
+import {
+  isRenderedInHistory,
+  belongsInConfirmationQueue,
+  isVisibleInToolGroup,
+} from './tool-visibility.js';
+import {
+  UPDATE_TOPIC_TOOL_NAME,
+  UPDATE_TOPIC_DISPLAY_NAME,
+  WRITE_FILE_DISPLAY_NAME,
+  EDIT_DISPLAY_NAME,
+  ASK_USER_DISPLAY_NAME,
+} from '../tools/tool-names.js';
+
+describe('tool-visibility', () => {
+  describe('belongsInConfirmationQueue', () => {
+    it('returns false for update_topic tool name and display name', () => {
+      expect(
+        belongsInConfirmationQueue({
+          name: UPDATE_TOPIC_TOOL_NAME,
+          displayName: 'Topic',
+          status: CoreToolCallStatus.Scheduled,
+          hasResultDisplay: false,
+        }),
+      ).toBe(false);
+
+      expect(
+        belongsInConfirmationQueue({
+          name: 'update_topic',
+          displayName: UPDATE_TOPIC_DISPLAY_NAME,
+          status: CoreToolCallStatus.Scheduled,
+          hasResultDisplay: false,
+        }),
+      ).toBe(false);
+    });
+
+    it('returns true for standard tools like write_file', () => {
+      expect(
+        belongsInConfirmationQueue({
+          name: 'write_file',
+          displayName: 'WriteFile',
+          status: CoreToolCallStatus.Scheduled,
+          hasResultDisplay: false,
+        }),
+      ).toBe(true);
+    });
+  });
+
+  describe('isRenderedInHistory', () => {
+    it('returns false for tool calls with a parentCallId', () => {
+      expect(
+        isRenderedInHistory({
+          name: 'write_file',
+          displayName: 'WriteFile',
+          status: CoreToolCallStatus.Success,
+          hasResultDisplay: true,
+          parentCallId: 'some-parent',
+        }),
+      ).toBe(false);
+    });
+
+    it('handles ASK_USER_DISPLAY_NAME correctly based on status', () => {
+      const statusesToHide = [
+        CoreToolCallStatus.Scheduled,
+        CoreToolCallStatus.Validating,
+        CoreToolCallStatus.Executing,
+        CoreToolCallStatus.AwaitingApproval,
+      ];
+      for (const status of statusesToHide) {
+        expect(
+          isRenderedInHistory({
+            name: 'ask_user',
+            displayName: ASK_USER_DISPLAY_NAME,
+            status,
+            hasResultDisplay: false,
+          }),
+        ).toBe(false);
+      }
+
+      expect(
+        isRenderedInHistory({
+          name: 'ask_user',
+          displayName: ASK_USER_DISPLAY_NAME,
+          status: CoreToolCallStatus.Error,
+          hasResultDisplay: false,
+        }),
+      ).toBe(false);
+
+      expect(
+        isRenderedInHistory({
+          name: 'ask_user',
+          displayName: ASK_USER_DISPLAY_NAME,
+          status: CoreToolCallStatus.Error,
+          hasResultDisplay: true,
+        }),
+      ).toBe(true);
+    });
+
+    it('handles PLAN mode WRITE_FILE and EDIT correctly', () => {
+      expect(
+        isRenderedInHistory({
+          name: 'write_file',
+          displayName: WRITE_FILE_DISPLAY_NAME,
+          status: CoreToolCallStatus.Success,
+          approvalMode: ApprovalMode.PLAN,
+          hasResultDisplay: true,
+        }),
+      ).toBe(false);
+
+      expect(
+        isRenderedInHistory({
+          name: 'edit',
+          displayName: EDIT_DISPLAY_NAME,
+          status: CoreToolCallStatus.Success,
+          approvalMode: ApprovalMode.DEFAULT,
+          hasResultDisplay: true,
+        }),
+      ).toBe(true);
+    });
+  });
+
+  describe('isVisibleInToolGroup', () => {
+    it('handles low verbosity error cases correctly', () => {
+      const ctx = {
+        name: 'write_file',
+        displayName: 'WriteFile',
+        status: CoreToolCallStatus.Error,
+        isClientInitiated: false,
+        hasResultDisplay: false,
+      };
+      
+      expect(isVisibleInToolGroup(ctx, 'low')).toBe(false);
+      expect(isVisibleInToolGroup(ctx, 'full')).toBe(true);
+    });
+
+    it('returns false for tools awaiting approval', () => {
+      const ctx = {
+        name: 'write_file',
+        displayName: 'WriteFile',
+        status: CoreToolCallStatus.AwaitingApproval,
+        hasResultDisplay: false,
+      };
+
+      expect(isVisibleInToolGroup(ctx, 'full')).toBe(false);
+    });
+  });
+});
