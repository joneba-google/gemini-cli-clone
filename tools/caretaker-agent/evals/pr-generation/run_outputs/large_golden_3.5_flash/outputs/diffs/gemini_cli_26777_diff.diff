+/**
+ * Checks if a canonical resolved real path is a trusted system path.
+ * On Windows, checks if it falls under SystemRoot or ProgramFiles.
+ * On Unix, checks if it falls under /usr/bin, /bin, /usr/sbin, /sbin, or /usr/local/bin.
+ */
+export function isTrustedSystemPath(realPath: string): boolean {
+  if (os.platform() === 'win32') {
+    const systemRoot = process.env['SystemRoot'];
+    const programFiles = process.env['ProgramFiles'];
+    const programFilesX86 = process.env['ProgramFiles(x86)'];
+
+    if (systemRoot && isSubpath(systemRoot, realPath)) {
+      return true;
+    }
+    if (programFiles && isSubpath(programFiles, realPath)) {
+      return true;
+    }
+    if (programFilesX86 && isSubpath(programFilesX86, realPath)) {
+      return true;
+    }
+    return false;
+  } else {
+    const trustedPrefixes = [
+      '/usr/bin',
+      '/bin',
+      '/usr/sbin',
+      '/sbin',
+      '/usr/local/bin',
+    ];
+    for (const prefix of trustedPrefixes) {
+      if (isSubpath(prefix, realPath)) {
+        return true;
+      }
+    }
+    return false;
+  }
+}
