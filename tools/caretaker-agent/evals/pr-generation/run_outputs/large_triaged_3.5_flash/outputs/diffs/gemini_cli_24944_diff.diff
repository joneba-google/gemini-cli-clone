+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import '../../test-utils/polyfill.js';
+import { describe, expect, it } from 'vitest';
+import { CoreToolCallStatus } from '@google/gemini-cli-core';
+import { getConfirmingToolState } from './confirmingTool.js';
+import type { HistoryItemWithoutId } from '../types.js';
+
+describe('getConfirmingToolState', () => {
+  it('returns null when there are no tools awaiting approval', () => {
+    const pendingHistoryItems: HistoryItemWithoutId[] = [
+      {
+        type: 'tool_group',
+        tools: [
+          {
+            callId: 'tool-1',
+            status: CoreToolCallStatus.Executing,
+            description: 'Run background command',
+          },
+          {
+            callId: 'tool-2',
+            status: CoreToolCallStatus.Success,
+            description: 'Completed tool',
+          },
+        ],
+      } as never,
+    ];
+
+    const result = getConfirmingToolState(pendingHistoryItems);
+    expect(result).toBeNull();
+  });
+
+  it('excludes background/unconfirming tools from the confirmation queue count', () => {
+    const pendingHistoryItems: HistoryItemWithoutId[] = [
+      {
+        type: 'tool_group',
+        tools: [
+          {
+            callId: 'update_topic_1',
+            status: CoreToolCallStatus.Executing,
+            description: 'Update topic (background)',
+          },
+          {
+            callId: 'confirm_tool_1',
+            status: CoreToolCallStatus.AwaitingApproval,
+            description: 'Database query requiring approval',
+          },
+        ],
+      } as never,
+    ];
+
+    const result = getConfirmingToolState(pendingHistoryItems);
+    expect(result).not.toBeNull();
+    expect(result?.tool.callId).toBe('confirm_tool_1');
+    expect(result?.total).toBe(1);
+    expect(result?.index).toBe(1);
+  });
+
+  it('correctly calculates total and 1-based index when multiple tools requires approval', () => {
+    const pendingHistoryItems: HistoryItemWithoutId[] = [
+      {
+        type: 'tool_group',
+        tools: [
+          {
+            callId: 'confirm_tool_1',
+            status: CoreToolCallStatus.AwaitingApproval,
+            description: 'First tool requiring approval',
+          },
+          {
+            callId: 'update_topic_1',
+            status: CoreToolCallStatus.Executing,
+            description: 'Background tool',
+          },
+          {
+            callId: 'confirm_tool_2',
+            status: CoreToolCallStatus.AwaitingApproval,
+            description: 'Second tool requiring approval',
+          },
+        ],
+      } as never,
+    ];
+
+    const result = getConfirmingToolState(pendingHistoryItems);
+    expect(result).not.toBeNull();
+    expect(result?.tool.callId).toBe('confirm_tool_1');
+    expect(result?.total).toBe(2);
+    expect(result?.index).toBe(1);
+  });
+});
