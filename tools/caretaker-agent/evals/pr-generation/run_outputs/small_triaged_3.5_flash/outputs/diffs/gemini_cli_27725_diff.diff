+
+  it('should NOT populate structuredContent if parsed value is not a record/object (e.g., array)', async () => {
+    const mockTransport = createMockTransport();
+    const complianceTransport = new McpComplianceTransport(mockTransport);
+    const onMessage = vi.fn();
+    complianceTransport.onmessage = onMessage;
+
+    const arrayResponse: JSONRPCMessage = {
+      jsonrpc: '2.0',
+      id: 1,
+      result: {
+        content: [
+          {
+            type: 'text',
+            text: JSON.stringify([{ id: 'event-1' }, { id: 'event-2' }]),
+          },
+        ],
+      },
+    };
+
+    mockTransport.onmessage!(arrayResponse);
+    expect(onMessage.mock.calls[0][0].result.structuredContent).toBeUndefined();
+  });
+
+  it('should NOT populate structuredContent if parsed value is a primitive', async () => {
+    const mockTransport = createMockTransport();
+    const complianceTransport = new McpComplianceTransport(mockTransport);
+    const onMessage = vi.fn();
+    complianceTransport.onmessage = onMessage;
+
+    const primitiveResponse: JSONRPCMessage = {
+      jsonrpc: '2.0',
+      id: 1,
+      result: {
+        content: [
+          {
+            type: 'text',
+            text: JSON.stringify('some simple string value'),
+          },
+        ],
+      },
+    };
+
+    mockTransport.onmessage!(primitiveResponse);
+    expect(onMessage.mock.calls[0][0].result.structuredContent).toBeUndefined();
+  });
 });
