+++ b/packages/core/src/utils/tool-visibility.ts
@@ -0,0 +1,135 @@
+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { ApprovalMode } from '../policy/types.js';
+import { CoreToolCallStatus } from '../scheduler/types.js';
+import {
+  UPDATE_TOPIC_TOOL_NAME,
+  UPDATE_TOPIC_DISPLAY_NAME,
+  ASK_USER_DISPLAY_NAME,
+  WRITE_FILE_DISPLAY_NAME,
+  EDIT_DISPLAY_NAME,
+} from '../tools/tool-names.js';
+
+export interface ToolVisibilityContext {
+  name: string;
+  displayName: string;
+  status: CoreToolCallStatus;
+  approvalMode?: ApprovalMode;
+  hasResultDisplay: boolean;
+  parentCallId?: string;
+  isClientInitiated?: boolean;
+}
+
+export interface ToolVisibilityInput {
+  name?: string;
+  status: CoreToolCallStatus;
+  approvalMode?: ApprovalMode;
+  parentCallId?: string;
+  isClientInitiated?: boolean;
+  tool?: {
+    displayName?: string;
+  };
+  request?: {
+    name?: string;
+    parentCallId?: string;
+    isClientInitiated?: boolean;
+  };
+  response?: {
+    resultDisplay?: unknown;
+  };
+  resultDisplay?: unknown;
+  liveOutput?: unknown;
+  progressMessage?: unknown;
+}
+
+export function buildToolVisibilityContext(tc: ToolVisibilityInput): ToolVisibilityContext {
+  const displayName = tc.tool?.displayName ?? tc.request?.name ?? tc.name ?? '';
+  const name = tc.request?.name ?? tc.name ?? '';
+  const status = tc.status;
+  const parentCallId = tc.request?.parentCallId ?? tc.parentCallId;
+  const approvalMode = tc.approvalMode;
+
+  let hasResultDisplay = false;
+  if (
+    status === CoreToolCallStatus.Success ||
+    status === CoreToolCallStatus.Error ||
+    status === CoreToolCallStatus.Cancelled
+  ) {
+    hasResultDisplay = !!tc.response?.resultDisplay || !!tc.resultDisplay;
+  } else if (status === CoreToolCallStatus.Executing) {
+    hasResultDisplay = !!tc.liveOutput || !!tc.progressMessage;
+  }
+
+  return {
+    name,
+    displayName,
+    status,
+    approvalMode,
+    hasResultDisplay,
+    parentCallId,
+    isClientInitiated: tc.isClientInitiated ?? tc.request?.isClientInitiated,
+  };
+}
+
+export function isRenderedInHistory(ctx: ToolVisibilityContext): boolean {
+  if (ctx.parentCallId) {
+    return false;
+  }
+
+  switch (ctx.displayName) {
+    case ASK_USER_DISPLAY_NAME:
+      switch (ctx.status) {
+        case CoreToolCallStatus.Scheduled:
+        case CoreToolCallStatus.Validating:
+        case CoreToolCallStatus.Executing:
+        case CoreToolCallStatus.AwaitingApproval:
+          return false;
+        case CoreToolCallStatus.Error:
+          return ctx.hasResultDisplay;
+        default:
+          return true;
+      }
+    case WRITE_FILE_DISPLAY_NAME:
+    case EDIT_DISPLAY_NAME:
+      return ctx.approvalMode !== ApprovalMode.PLAN;
+    default:
+      return true;
+  }
+}
+
+export function belongsInConfirmationQueue(ctx: ToolVisibilityContext): boolean {
+  if (
+    ctx.name === UPDATE_TOPIC_TOOL_NAME ||
+    ctx.displayName === UPDATE_TOPIC_DISPLAY_NAME
+  ) {
+    return false;
+  }
+  return true;
+}
+
+export function isVisibleInToolGroup(
+  ctx: ToolVisibilityContext,
+  verbosity: 'low' | 'full',
+): boolean {
+  if (
+    verbosity === 'low' &&
+    ctx.status === CoreToolCallStatus.Error &&
+    !ctx.isClientInitiated
+  ) {
+    return false;
+  }
+
+  if (!isRenderedInHistory(ctx)) {
+    return false;
+  }
+
+  if (ctx.status === CoreToolCallStatus.AwaitingApproval) {
+    return false;
+  }
+
+  return true;
+}