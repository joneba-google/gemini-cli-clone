 export const VISUAL_AGENT_MODEL = 'gemini-2.5-computer-use-preview-10-2025';
 
+/**
+ * Pattern to identify computer-use capable models.
+ */
+export const COMPUTER_USE_MODEL_PATTERN = /^gemini-.*-computer-use-/;
+
+/**
+ * Helper function to detect if a given model is computer-use capable.
+ *
+ * @param model Model name
+ * @returns true if the model is computer-use capable
+ */
+export function isComputerUseModel(model: string): boolean {
+  return COMPUTER_USE_MODEL_PATTERN.test(model);
+}
