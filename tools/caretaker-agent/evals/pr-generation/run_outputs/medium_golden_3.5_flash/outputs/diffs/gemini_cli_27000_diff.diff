+describe('modelConfigService.getResolvedConfig for 3.1 models', () => {
+  it('should resolve with a defined thinkingLevel inside the thinkingConfig of generateContentConfig', () => {
+    const models = [
+      PREVIEW_GEMINI_3_1_MODEL,
+      PREVIEW_GEMINI_3_1_CUSTOM_TOOLS_MODEL,
+      PREVIEW_GEMINI_3_1_FLASH_LITE_MODEL,
+    ];
+
+    for (const model of models) {
+      const resolved = modelConfigService.getResolvedConfig({ model });
+      expect(resolved.generateContentConfig?.thinkingConfig?.thinkingLevel).toBeDefined();
+      expect(resolved.generateContentConfig?.thinkingConfig?.thinkingLevel).toBe('HIGH');
+    }
+  });
+});
