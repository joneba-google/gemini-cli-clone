+      await createTestFile('.venv', 'bin', 'activate');
+      await createTestFile('node_modules', 'some-package', 'index.js');
+
+      const fileService = new FileDiscoveryService(testRootDir);
+      const structure = await getFolderStructure(testRootDir, {
+        fileService,
+      });
+
