@@ -0,0 +1,98 @@
+/**
+ * @license
+ * Copyright 2025 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, expect, it } from 'vitest';
+import { validatePath, MAX_PATH_LENGTH, MAX_COMPONENT_LENGTH } from './path-validator.js';
+import { resolveAtCommandPath, tryExtractPath } from './atCommandUtils.js';
+
+describe('validatePath', () => {
+  it('accepts standard valid paths', () => {
+    expect(validatePath('src/utils/path-validator.ts')).toBe(true);
+    expect(validatePath('/usr/local/bin/node')).toBe(true);
+    expect(validatePath('C:\\Users\\User\\Documents\\file.txt')).toBe(true);
+  });
+
+  it('accepts valid paths with spaces, apostrophes, and brackets', () => {
+    expect(validatePath('folder name/file.txt')).toBe(true);
+    expect(validatePath("packages/foo/it's-a-cool-file.ts")).toBe(true);
+    expect(validatePath('[my-folder]/file.ts')).toBe(true);
+    expect(validatePath('some[brackets]here/test.js')).toBe(true);
+  });
+
+  it('rejects non-string inputs', () => {
+    expect(validatePath(null)).toBe(false);
+    expect(validatePath(undefined)).toBe(false);
+    expect(validatePath(123)).toBe(false);
+    expect(validatePath({})).toBe(false);
+  });
+
+  it('rejects empty paths', () => {
+    expect(validatePath('')).toBe(false);
+  });
+
+  it('rejects paths exceeding maximum length', () => {
+    const longPath = 'a'.repeat(MAX_PATH_LENGTH + 1);
+    expect(validatePath(longPath)).toBe(false);
+  });
+
+  it('rejects paths with components exceeding maximum component length', () => {
+    const longComponent = 'a'.repeat(MAX_COMPONENT_LENGTH + 1);
+    expect(validatePath(`src/utils/${longComponent}/file.ts`)).toBe(false);
+    expect(validatePath(longComponent)).toBe(false);
+  });
+
+  it('rejects paths with newlines and control characters', () => {
+    expect(validatePath('src/utils\n/path-validator.ts')).toBe(false);
+    expect(validatePath('src/utils/\rpath-validator.ts')).toBe(false);
+    expect(validatePath('src/utils/\0path-validator.ts')).toBe(false);
+    expect(validatePath('src/utils/\tpath-validator.ts')).toBe(false);
+  });
+
+  it('rejects paths with log markers', () => {
+    expect(validatePath('AssertionError: expected false to be true')).toBe(false);
+    expect(validatePath('FAIL  packages/core/src/utils/paths.test.ts')).toBe(false);
+    expect(validatePath('✓ test passed')).toBe(false);
+    expect(validatePath('× test failed')).toBe(false);
+    expect(validatePath('TestingLibraryElementError: Unable to find element')).toBe(false);
+
+    // In subpaths
+    expect(validatePath('logs/AssertionError: details')).toBe(false);
+    expect(validatePath('logs\\AssertionError: details')).toBe(false);
+  });
+
+  it('rejects paths with suspicious quotes or ellipses', () => {
+    expect(validatePath('src/utils/.../path.ts')).toBe(false);
+    expect(validatePath('src/utils/…/path.ts')).toBe(false);
+    expect(validatePath('src/utils/`path`/file.ts')).toBe(false);
+
+    // Unbalanced double quotes
+    expect(validatePath('src/utils/"/file.ts')).toBe(false);
+    expect(validatePath('"src/utils/file.ts')).toBe(false);
+
+    // Double quotes in middle
+    expect(validatePath('src/utils/"folder"/file.ts')).toBe(false);
+  });
+
+  it('accepts double quotes only if they enclose the whole path', () => {
+    expect(validatePath('"C:\\Users\\User\\Documents\\file.txt"')).toBe(true);
+    expect(validatePath('"src/utils/file.ts"')).toBe(true);
+  });
+});
+
+describe('tryExtractPath & resolveAtCommandPath', () => {
+  it('extracts valid paths from log fragments and stack traces', () => {
+    expect(tryExtractPath('AssertionError: expected false to be true at src/utils/paths.ts:123')).toBe('src/utils/paths.ts');
+    expect(tryExtractPath('at fn (/usr/local/bin/node:45:21)')).toBe('/usr/local/bin/node');
+    expect(tryExtractPath('FAIL packages/core/src/utils/paths.test.ts:32')).toBe('packages/core/src/utils/paths.test.ts');
+    expect(tryExtractPath('error in "src/config/config.ts" at line 34')).toBe('src/config/config.ts');
+  });
+
+  it('resolves valid directly or by extraction', () => {
+    expect(resolveAtCommandPath('src/utils/paths.ts')).toBe('src/utils/paths.ts');
+    expect(resolveAtCommandPath('FAIL packages/core/src/utils/paths.test.ts:32')).toBe('packages/core/src/utils/paths.test.ts');
+    expect(resolveAtCommandPath('no path here')).toBeNull();
+  });
+});
