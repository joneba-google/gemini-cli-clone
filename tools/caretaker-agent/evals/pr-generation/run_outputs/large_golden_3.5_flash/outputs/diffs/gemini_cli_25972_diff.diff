@@ -0,0 +1,70 @@
+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { validatePath } from './path-validator.js';
+
+/**
+ * Attempts to extract a valid-looking path from a string or log fragment on a best-effort basis.
+ */
+export function tryExtractPath(pathStr: string): string | null {
+  if (!pathStr || typeof pathStr !== 'string') {
+    return null;
+  }
+
+  const parsedClean = pathStr.trim();
+  const hasSpaces = /\s/.test(parsedClean);
+  const isQuoted = /^["'`].*["'`]$/.test(parsedClean);
+
+  // 1. If single line and represents a single clean path (no unquoted spaces), check and clean it
+  if (!/[\n\r\t\0]/.test(pathStr) && (!hasSpaces || isQuoted)) {
+    let clean = parsedClean;
+    // remove enclosing quotes if both sides match
+    clean = clean.replace(/^["'`]|["'`]$/g, '');
+    // remove brackets/parentheses if they enclose
+    clean = clean.replace(/^\((.*)\)$/, '$1');
+    clean = clean.replace(/^\[(.*)\]$/, '$1');
+    // Strip trailing line/col numbers
+    clean = clean.replace(/:\d+(?::\d+)?$/, '');
+    clean = clean.trim();
+
+    if (validatePath(clean)) {
+      return clean;
+    }
+  }
+
+  // 2. Tokenize by space, parenthesis, square brackets, or newlines
+  const tokens = pathStr.split(/[\s()[\]\n\r\t\0]/);
+  for (let token of tokens) {
+    if (!token) continue;
+    token = token.trim();
+    // Strip enclosing quotes and trailing line/col numbers
+    token = token.replace(/^[":'`]|[":'`]$/g, '');
+    token = token.replace(/:\d+(?::\d+)?$/, '');
+    token = token.trim();
+
+    if (!token) continue;
+
+    // Must look like a path with file extension and not be an ellipsis/etc.
+    const hasExtension = /\.[a-zA-Z0-9]+$/.test(token);
+    const notEllipsis = !/\.\.\./.test(token) && !/…/.test(token);
+    if (hasExtension && notEllipsis && validatePath(token)) {
+      return token;
+    }
+  }
+
+  return null;
+}
+
+/**
+ * Resolves raw AT-command path input, validating format and extracting path when embedded in logs.
+ */
+export function resolveAtCommandPath(pathStr: string): string | null {
+  const extracted = tryExtractPath(pathStr);
+  if (!extracted || !validatePath(extracted)) {
+    return null;
+  }
+  return extracted;
+}
