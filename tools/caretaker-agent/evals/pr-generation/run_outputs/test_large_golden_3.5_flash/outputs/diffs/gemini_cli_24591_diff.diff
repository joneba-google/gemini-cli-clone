diff --git a/packages/cli/src/utils/processUtils.ts b/packages/cli/src/utils/processUtils.ts
index c43f5c54f..5c4f70f50 100644
--- a/packages/cli/src/utils/processUtils.ts
+++ b/packages/cli/src/utils/processUtils.ts
@@ -29,3 +29,64 @@ export async function relaunchApp(): Promise<void> {
   await runExitCleanup();
   process.exit(RELAUNCH_EXIT_CODE);
 }
+
+export interface ProcessWithSea extends NodeJS.Process {
+  isSea?: () => boolean;
+}
+
+export function isSeaEnvironment(): boolean {
+  return (
+    process.env['IS_BINARY'] === 'true' ||
+    (process as ProcessWithSea).isSea?.() === true
+  );
+}
+
+export function isStandardSea(): boolean {
+  return process.argv[0] !== process.argv[1] && isSeaEnvironment();
+}
+
+export function getScriptArgs(): string[] {
+  return isStandardSea() ? process.argv.slice(1) : process.argv.slice(2);
+}
+
+export function getSpawnConfig(
+  nodeArgs: string[],
+  scriptArgs: string[],
+): {
+  spawnArgs: string[];
+  newEnv: NodeJS.ProcessEnv;
+} {
+  const newEnv: NodeJS.ProcessEnv = { ...process.env, GEMINI_CLI_NO_RELAUNCH: 'true' };
+
+  if (isSeaEnvironment()) {
+    for (const arg of nodeArgs) {
+      if (/[\s'"\\]/.test(arg)) {
+        throw new Error(
+          `Invalid Node option passed in SEA mode: "${arg}". Options must not contain spaces, quotes, or backslashes.`,
+        );
+      }
+    }
+    const existingNodeOptions = process.env['NODE_OPTIONS'];
+    if (nodeArgs.length > 0) {
+      const nodeOptionsStr = nodeArgs.join(' ');
+      newEnv['NODE_OPTIONS'] = existingNodeOptions
+        ? `${existingNodeOptions} ${nodeOptionsStr}`
+        : nodeOptionsStr;
+    }
+    return {
+      spawnArgs: [process.execPath, ...scriptArgs],
+      newEnv,
+    };
+  } else {
+    return {
+      spawnArgs: [
+        ...process.execArgv,
+        ...nodeArgs,
+        process.argv[1],
+        ...scriptArgs,
+      ],
+      newEnv,
+    };
+  }
+}
+
