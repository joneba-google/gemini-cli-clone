diff --git a/packages/cli/src/ui/hooks/useGitBranchName.test.tsx b/packages/cli/src/ui/hooks/useGitBranchName.test.tsx
index dd85e73e7..d2592625d 100644
--- a/packages/cli/src/ui/hooks/useGitBranchName.test.tsx
+++ b/packages/cli/src/ui/hooks/useGitBranchName.test.tsx
@@ -247,4 +247,72 @@ describe('useGitBranchName', () => {
     unmount();
     expect(closeMock).toHaveBeenCalled();
   });
+
+  it('should correctly determine branch name when cwd is a subdirectory within a git repository', async () => {
+    const SUBDIR = path.join(CWD, 'packages', 'cli');
+
+    (
+      mockSpawnAsync as MockedFunction<typeof mockSpawnAsync>
+    ).mockImplementation(async (command: string, args: string[]) => {
+      if (args.includes('--git-dir')) {
+        return { stdout: '/test/project/.git\n' } as { stdout: string; stderr: string };
+      }
+      if (args.includes('--abbrev-ref')) {
+        return { stdout: 'feature-branch\n' } as { stdout: string; stderr: string };
+      }
+      return { stdout: '' } as { stdout: string; stderr: string };
+    });
+
+    const { result, rerender } = renderGitBranchNameHook(SUBDIR);
+
+    await act(async () => {
+      rerender();
+    });
+
+    expect(result.current).toBe('feature-branch');
+  });
+
+  it('should update branch name when HEAD changes directly (if logs/HEAD does not exist)', async () => {
+    const gitHeadPath = path.join(CWD, '.git', 'HEAD');
+    vol.reset();
+    vol.fromJSON({
+      [gitHeadPath]: 'ref: refs/heads/main',
+    });
+
+    const watchSpy = vi.spyOn(fs, 'watch');
+
+    (mockSpawnAsync as MockedFunction<typeof mockSpawnAsync>)
+      .mockImplementation(async (command: string, args: string[]) => {
+        if (args.includes('--git-dir')) {
+          return { stdout: '.git\n' } as { stdout: string; stderr: string };
+        }
+        if (args.includes('--abbrev-ref')) {
+          const headContent = fs.readFileSync(gitHeadPath, 'utf8');
+          const branch = headContent.includes('develop') ? 'develop' : 'main';
+          return { stdout: `${branch}\n` } as { stdout: string; stderr: string };
+        }
+        return { stdout: '' } as { stdout: string; stderr: string };
+      });
+
+    const { result, rerender } = renderGitBranchNameHook(CWD);
+
+    await act(async () => {
+      rerender();
+    });
+    expect(result.current).toBe('main');
+
+    await waitFor(() => {
+      expect(watchSpy).toHaveBeenCalledWith(gitHeadPath, expect.any(Function));
+    });
+
+    await act(async () => {
+      fs.writeFileSync(gitHeadPath, 'ref: refs/heads/develop');
+      rerender();
+    });
+
+    await waitFor(() => {
+      expect(result.current).toBe('develop');
+    });
+  });
 });
+
