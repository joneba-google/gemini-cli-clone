+    const skillFile = path.join(skillDir, 'SKILL.md');
+    await fs.writeFile(
+      skillFile,
+      '\uFEFF---\nname: bom-skill\ndescription: A test skill with UTF-8 BOM\n---\n# Instructions\nDo something.\n',
+    );
+
+    const skills = await loadSkillsFromDir(testRootDir);
+
+    expect(skills).toHaveLength(1);
+    expect(skills[0].name).toBe('bom-skill');
+    expect(skills[0].description).toBe('A test skill with UTF-8 BOM');
+  });
+
+  it('should parse skill with trailing horizontal spaces after frontmatter markers', async () => {
+    const skillDir = path.join(testRootDir, 'trailing-spaces');
+    await fs.mkdir(skillDir, { recursive: true });
+    const skillFile = path.join(skillDir, 'SKILL.md');
+    await fs.writeFile(
+      skillFile,
+      `--- \t \nname: trailing-spaces-skill\ndescription: A skill with trailing spaces\n---  \n# Instructions\nDo something.\n`,
+    );
+
+    const skills = await loadSkillsFromDir(testRootDir);
+
+    expect(skills).toHaveLength(1);
+    expect(skills[0].name).toBe('trailing-spaces-skill');
+    expect(skills[0].description).toBe('A skill with trailing spaces');
+  });
+
+  it('should parse skill with case-insensitivity and spacing around colons in simple parser', async () => {
+    const skillDir = path.join(testRootDir, 'case-spacing');
+    await fs.mkdir(skillDir, { recursive: true });
+    const skillFile = path.join(skillDir, 'SKILL.md');
+    // Using a description with a colon to force the simple parser fallback
+    await fs.writeFile(
+      skillFile,
+      `---
+  NAME   : case-spacing-skill
+  DESCRIPTION  : Parsing issues: resolved in simple parser fallback
+---
+`,
+    );
+
+    const skills = await loadSkillsFromDir(testRootDir);
+
+    expect(skills).toHaveLength(1);
+    expect(skills[0].name).toBe('case-spacing-skill');
+    expect(skills[0].description).toBe('Parsing issues: resolved in simple parser fallback');
+  });
+
+  it('should prevent swallowing of indented keys during multi-line description continuation in simple parser', async () => {
+    const skillDir = path.join(testRootDir, 'prevent-swallowing');
+    await fs.mkdir(skillDir, { recursive: true });
+    const skillFile = path.join(skillDir, 'SKILL.md');
+    // Force simple parser fallback via a colon in the description line
+    await fs.writeFile(
+      skillFile,
+      `---
+  description: Multi-line description: has a colon
+    name: swallowed-key-prevention
+---
+`,
+    );
+
+    const skills = await loadSkillsFromDir(testRootDir);
+
+    expect(skills).toHaveLength(1);
+    expect(skills[0].name).toBe('swallowed-key-prevention');
+    expect(skills[0].description).toBe('Multi-line description: has a colon');
+  });
 });
